# Copy to .env (which git ignores) and fill in the provider you use.
# browser needs nothing; the player speaks with the browser's own voice.
TTS_PROVIDER=browser

# Azure AI Speech (also run: npm install microsoft-cognitiveservices-speech-sdk)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uksouth
AZURE_SPEECH_VOICE=en-GB-RyanNeural

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
