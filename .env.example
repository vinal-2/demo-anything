# Copy to .env (git ignores it) and fill in only what you use. Never commit .env.
# A flow's "narrator" in flow.json wins over these; --provider/--voice flags win over both.

# browser | kokoro | elevenlabs | google | recorded
TTS_PROVIDER=browser
TTS_SPEED=1.0

# Kokoro: free and local. Install with: npm install kokoro-js
KOKORO_VOICE=bm_george

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Google Cloud Text-to-Speech: an API key restricted to the Text-to-Speech API
GOOGLE_API_KEY=
GOOGLE_TTS_VOICE=en-GB-Chirp3-HD-Charon

# Python used for --align (faster-whisper or openai-whisper), if not "python"
# PYTHON=python
